<%== render("topbar") %>
<main>
  <h1>Job</h1>
  <nav>
    <ul>
      <li><a href="/jobs?state=<%= @job[:dead_at] ? "dead" : "due" %>">← All jobs</a></li>
    </ul>
  </nav>
  <article>
    <dl>
      <dt>Class</dt><dd class="mono"><%= @job[:job_class] %></dd>
      <dt>ID</dt><dd class="mono"><%= @job[:id] %></dd>
      <dt>Attempts</dt><dd class="<%= @job[:attempts].zero? ? "" : "warn" %>"><%= @job[:attempts] %> of <%= Jobs::Worker::MAX_ATTEMPTS %></dd>
      <dt>Created (UTC)</dt><dd><%= utc(@job[:created_at]) %></dd>
      <dt>Scheduled (UTC)</dt><dd><%= utc(@job[:scheduled_at]) %></dd>
      <dt>Locked (UTC)</dt><dd><%= utc(@job[:locked_at]) || "—" %></dd>
      <dt>Dead (UTC)</dt><dd class="bad"><%= utc(@job[:dead_at]) || "—" %></dd>
    </dl>
    <h3>Arguments</h3>
    <pre><%= pretty_json(@job[:args]) %></pre>
    <h3>Last error</h3>
    <% if @job[:last_error] %>
      <pre class="bad"><%= @job[:last_error] %></pre>
    <% else %>
      <p class="empty">None.</p>
    <% end %>
  </article>
</main>
<script src="/admin.js"></script>
