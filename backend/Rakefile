# frozen_string_literal: true

require "bundler/setup"
require "sequel"
require_relative "lib/config"
APP_CONFIG.load!

namespace :db do
  desc "Create the database"
  task :create do
    database_url = APP_CONFIG.database_url
    db_name = database_url.split("/").last

    # Connect to a maintenance database to issue CREATE DATABASE.
    # Prefer `postgres` to avoid connecting to sibling app databases, which
    # can break DatabaseCleaner transaction isolation during parallel CI runs.
    candidates = ["postgres"] + (%w[tayaway_development tayaway_test tayaway_e2e] - [db_name])
    db = nil
    candidates.each do |candidate|
      maintenance_url = database_url.sub(/\/[^\/]+$/, "/#{candidate}")
      db = Sequel.connect(maintenance_url)
      db.test_connection
      break
    rescue Sequel::DatabaseConnectionError
      db&.disconnect
      db = nil
    end
    raise "Could not connect to any maintenance database" unless db

    begin
      db.execute "CREATE DATABASE #{db_name}"
      puts "Created database: #{db_name}"
    rescue Sequel::DatabaseError => e
      if e.message.include?("already exists")
        puts "Database #{db_name} already exists"
      else
        raise
      end
    ensure
      db.disconnect
    end
  end

  desc "Drop the database"
  task :drop do
    database_url = APP_CONFIG.database_url
    db_name = database_url.split("/").last

    candidates = ["postgres"] + (%w[tayaway_development tayaway_test tayaway_e2e] - [db_name])
    db = nil
    candidates.each do |candidate|
      maintenance_url = database_url.sub(/\/[^\/]+$/, "/#{candidate}")
      db = Sequel.connect(maintenance_url)
      db.test_connection
      break
    rescue Sequel::DatabaseConnectionError
      db&.disconnect
      db = nil
    end
    raise "Could not connect to any maintenance database" unless db

    begin
      db.execute "DROP DATABASE IF EXISTS #{db_name}"
      puts "Dropped database: #{db_name}"
    ensure
      db.disconnect
    end
  end

  desc "Run database migrations"
  task :migrate do
    require_relative "config/database"

    Sequel.extension :migration
    Sequel::Migrator.run(DB, "db/migrations")
    puts "Migrations complete"
  end

  desc "Rollback the last migration"
  task :rollback do
    require_relative "config/database"

    Sequel.extension :migration
    current_version = Sequel::IntegerMigrator.new(DB, "db/migrations").current
    Sequel::Migrator.run(DB, "db/migrations", target: current_version - 1)
    puts "Rollback complete"
  end

  desc "Reset the database"
  task reset: [:drop, :create, :migrate]

  desc "Seed the database"
  task :seed do
    require_relative "db/seeds"
    puts "Seeding complete"
  end

  desc "Report encryption format versions across all encrypted fields"
  task :encryption_report do
    require_relative "config/environment"

    encrypted_columns = %i[iban phone_number birthday]
    totals = Hash.new(0)

    DB[:users].select(*encrypted_columns).each do |row|
      encrypted_columns.each do |col|
        value = row[col]
        totals["#{col}:#{value.nil? ? "null" : Encryption.encrypted?(value) ? "v2" : "other"}"] += 1
      end
    end

    versions = %w[v2 other null]
    encrypted_columns.each do |col|
      puts "#{col}:"
      versions.each do |version|
        count = totals["#{col}:#{version}"]
        puts "  #{version}: #{count}" if count > 0
      end
    end
  end

  desc "Delete deleted_items rows older than DELETED_ITEMS_RETENTION_DAYS (default: 7)"
  task :cleanup_deleted_items do
    require_relative "config/database"

    retention_days = APP_CONFIG.deleted_items_retention_days
    cutoff = Time.now - (retention_days * 24 * 60 * 60)
    count = DB[:deleted_items].where { deleted_at < cutoff }.delete
    puts "Deleted #{count} deleted_items rows older than #{retention_days} days"
  end

  desc "Delete idempotency_keys rows older than IDEMPOTENCY_KEY_TTL_HOURS (default: 24)"
  task :cleanup_idempotency_keys do
    require_relative "config/database"

    ttl_hours = APP_CONFIG.idempotency_key_ttl_hours
    cutoff = Time.now - (ttl_hours * 60 * 60)
    count = DB[:idempotency_keys].where { created_at < cutoff }.delete
    puts "Deleted #{count} idempotency_keys rows older than #{ttl_hours} hours"
  end

  desc "Delete audit_log_entries rows older than AUDIT_LOG_RETENTION_DAYS (default: 365)"
  task :cleanup_audit_log_entries do
    require_relative "config/database"

    retention_days = APP_CONFIG.audit_log_retention_days
    cutoff = Time.now - (retention_days * 24 * 60 * 60)
    count = DB[:audit_log_entries].where { created_at < cutoff }.delete
    puts "Deleted #{count} audit_log_entries rows older than #{retention_days} days"
  end
end

namespace :notifications do
  desc "Generate a fresh VAPID key pair for push notifications"
  task :vapid do
    require "web-push"
    pair = WebPush.generate_key
    puts "VAPID_PUBLIC_KEY=#{pair.public_key}"
    puts "VAPID_PRIVATE_KEY=#{pair.private_key}"
    puts ""
    puts "Add these to your environment, plus VAPID_SUBJECT=mailto:you@example.com"
    puts "Restart the app afterwards. Existing browser subscriptions are tied to"
    puts "the old key — rotating means every subscriber re-subscribes."
  end
end

namespace :config do
  desc "Validate env vars against the Config schema and print which features are enabled"
  task :validate do
    enabled = APP_CONFIG.features.map(&:name).select { |n| APP_CONFIG.feature_enabled?(n) }
    disabled = APP_CONFIG.features.map(&:name) - enabled
    puts "env=#{APP_CONFIG.app_env}"
    puts "features enabled: #{enabled.empty? ? "(none)" : enabled.join(", ")}"
    puts "features disabled: #{disabled.empty? ? "(none)" : disabled.join(", ")}"
  end
end
