# frozen_string_literal: true

require "bundler/setup"
require "dotenv"
Dotenv.load(".env.#{ENV.fetch("RACK_ENV", "development")}")
require "sequel"

namespace :db do
  desc "Create the database"
  task :create do
    database_url = ENV.fetch("DATABASE_URL")
    db_name = database_url.split("/").last

    # Connect to a maintenance database to issue CREATE DATABASE.
    # Prefer `postgres` to avoid connecting to sibling app databases, which
    # can break DatabaseCleaner transaction isolation during parallel CI runs.
    candidates = ["postgres"] + (%w[tayaway_development tayaway_test tayaway_e2e] - [db_name])
    db = nil
    candidates.each do |candidate|
      maintenance_url = database_url.sub(/\/[^\/]+$/, "/#{candidate}")
      db = Sequel.connect(maintenance_url)
      db.test_connection
      break
    rescue Sequel::DatabaseConnectionError
      db&.disconnect
      db = nil
    end
    raise "Could not connect to any maintenance database" unless db

    begin
      db.execute "CREATE DATABASE #{db_name}"
      puts "Created database: #{db_name}"
    rescue Sequel::DatabaseError => e
      if e.message.include?("already exists")
        puts "Database #{db_name} already exists"
      else
        raise
      end
    ensure
      db.disconnect
    end
  end

  desc "Drop the database"
  task :drop do
    database_url = ENV.fetch("DATABASE_URL")
    db_name = database_url.split("/").last

    candidates = ["postgres"] + (%w[tayaway_development tayaway_test tayaway_e2e] - [db_name])
    db = nil
    candidates.each do |candidate|
      maintenance_url = database_url.sub(/\/[^\/]+$/, "/#{candidate}")
      db = Sequel.connect(maintenance_url)
      db.test_connection
      break
    rescue Sequel::DatabaseConnectionError
      db&.disconnect
      db = nil
    end
    raise "Could not connect to any maintenance database" unless db

    begin
      db.execute "DROP DATABASE IF EXISTS #{db_name}"
      puts "Dropped database: #{db_name}"
    ensure
      db.disconnect
    end
  end

  desc "Run database migrations"
  task :migrate do
    require_relative "config/database"

    Sequel.extension :migration
    Sequel::Migrator.run(DB, "db/migrations")
    puts "Migrations complete"
  end

  desc "Rollback the last migration"
  task :rollback do
    require_relative "config/database"

    Sequel.extension :migration
    current_version = Sequel::IntegerMigrator.new(DB, "db/migrations").current
    Sequel::Migrator.run(DB, "db/migrations", target: current_version - 1)
    puts "Rollback complete"
  end

  desc "Reset the database"
  task reset: [:drop, :create, :migrate]

  desc "Seed the database"
  task :seed do
    require_relative "db/seeds"
    puts "Seeding complete"
  end

  desc "Report encryption format versions across all encrypted fields"
  task :encryption_report do
    require_relative "config/environment"

    encrypted_columns = %i[iban phone_number birthday]
    totals = Hash.new(0)

    DB[:users].select(*encrypted_columns).each do |row|
      encrypted_columns.each do |col|
        value = row[col]
        totals["#{col}:#{value.nil? ? "null" : Encryption.encrypted?(value) ? "v2" : "other"}"] += 1
      end
    end

    versions = %w[v2 other null]
    encrypted_columns.each do |col|
      puts "#{col}:"
      versions.each do |version|
        count = totals["#{col}:#{version}"]
        puts "  #{version}: #{count}" if count > 0
      end
    end
  end

  desc "Backfill rsvp_snapshot on settlements that predate the chain feature"
  task :backfill_settlement_snapshots do
    require_relative "config/environment"

    dry_run = ENV["APPLY"] != "1"
    only_id = ENV["SETTLEMENT_ID"]
    puts dry_run ? "DRY RUN (set APPLY=1 to write)" : "APPLYING changes"

    scope = DB[:settlements].where(rsvp_snapshot: nil)
    scope = scope.where(id: only_id) if only_id
    candidates = scope.order(:created_at).all

    if candidates.empty?
      puts "No settlements need backfill."
      next
    end

    candidates.each do |row|
      settlement_id = row[:id]
      event = Event.find(row[:event_id])
      unless event&.start_date && event&.end_date
        warn "  SKIP #{settlement_id}: event missing dates"
        next
      end

      # Heuristic: include RSVPs that existed at settlement time and are
      # currently attending. Misses the edge case of someone who was
      # attending then and has since flipped to not-attending. Warnings
      # below flag anything the heuristic couldn't classify with confidence.
      rsvps = Rsvp.for_event(event.id)
      included = rsvps.select { |r| r.attending && r.created_at <= row[:created_at] }
      edited_after = rsvps.select { |r| r.updated_at > row[:created_at] && r.created_at <= row[:created_at] }
      newer_than_settlement = rsvps.reject { |r| r.created_at <= row[:created_at] }

      puts "\nSettlement #{settlement_id} (event #{event.id}, created #{row[:created_at]}):"
      puts "  include  (#{included.length}): #{included.map { |r| r.user_id.to_s }.join(", ")}"
      unless newer_than_settlement.empty?
        puts "  skipped — created after settlement (#{newer_than_settlement.length}): #{newer_than_settlement.map { |r| "#{r.user_id} attending=#{r.attending}" }.join(", ")}"
      end
      unless edited_after.empty?
        puts "  WARN — updated after settlement, current attending may differ from historical: #{edited_after.map { |r| "#{r.user_id} attending=#{r.attending}" }.join(", ")}"
      end

      if included.empty?
        warn "  SKIP #{settlement_id}: heuristic produced no attending RSVPs — verify manually"
        next
      end

      snapshot = Settlements::BalanceMath.snapshot_rsvps(included, event)
      if dry_run
        puts "  would write: #{snapshot.inspect}"
      else
        DB[:settlements].where(id: settlement_id).update(
          rsvp_snapshot: Sequel.pg_jsonb({ "rsvps" => snapshot })
        )
        puts "  wrote snapshot"
      end
    end
  end

  desc "Delete deleted_items rows older than DELETED_ITEMS_RETENTION_DAYS (default: 7)"
  task :cleanup_deleted_items do
    require_relative "config/database"

    retention_days = Integer(ENV.fetch("DELETED_ITEMS_RETENTION_DAYS", "7"))
    cutoff = Time.now - (retention_days * 24 * 60 * 60)
    count = DB[:deleted_items].where { deleted_at < cutoff }.delete
    puts "Deleted #{count} deleted_items rows older than #{retention_days} days"
  end
end
