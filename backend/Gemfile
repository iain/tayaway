source "https://rubygems.org"

ruby "~> 4.0.0"

# Web framework
gem "falcon"
gem "roda", "~> 3.98"
gem "roda-websockets"

# Database
gem "pg"
gem "sequel"
gem "sequel_pg", require: "sequel"

# JSON
gem "json"
gem "jwt"

# Environment
gem "dotenv"

# Email
gem "mail", "~> 2.8"

# Autoloading
gem "zeitwerk"

# Runtime type checking
gem "sorbet-static-and-runtime", require: "sorbet-runtime"

# Logging (extracted from default gems in Ruby 4.0)
gem "logger"

# Tasks
gem "rake"

group :development do
  gem "capistrano", require: false
  gem "concurrent-ruby-ext", require: false

  # listen for file changes
  gem "listen", require: false

  gem "rubocop", require: false
  gem "rubocop-performance", require: false
  gem "rubocop-rake", require: false
  gem "rubocop-rspec", require: false
  gem "rubocop-sequel", require: false
  gem "rubocop-sorbet", require: false
end

group :development, :test do
  gem "irb", require: false # Required for YARD compatibility with Ruby 4.0
  gem "pry", require: false
  gem "tapioca", ">= 0.17.10", require: false
end

group :test do
  gem "database_cleaner-sequel"
  gem "rack-test"
  gem "rspec"
end
