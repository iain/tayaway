source "https://rubygems.org"

ruby "~> 4.0.0"

# Web framework
gem "falcon"
gem "rack-attack"
gem "roda", "~> 3.106"
gem "roda-websockets"

# Server-rendered templates for the admin site (Roda render plugin)
gem "erubi"
gem "tilt"

# Database
gem "pg"
gem "sequel"
gem "sequel_pg", require: "sequel"
# Admin site credential/session store (doc/admin.md) — deliberately not Postgres,
# so operator login survives main-DB incidents.
gem "sqlite3"

# JSON. Floored past CVE-2026-33210 (fixed in 2.19.2) because ruby 4.0.6's
# default copy is 2.18.0 and containers/Containerfile deletes it, leaving this
# the only json in the image.
gem "json", ">= 2.19.2"
gem "jwt"

# Email
gem "mail", "~> 2.9"

# Web push notifications
gem "web-push", "~> 3.1"

# QR code generation
gem "chunky_png"
gem "rqrcode"

# Encryption (libsodium bindings)
gem "rbnacl"

# WebAuthn / Passkeys
gem "fido_metadata"
gem "webauthn"

# Session context — user-agent parsing and IP geolocation
gem "browser"
gem "mmdb"

# Monads
gem "dry-monads"

# Timezones — zone math (DST-aware) plus the bundled IANA database, so we
# don't depend on the host OS having tzdata installed.
gem "tzinfo"
gem "tzinfo-data"

# Autoloading
gem "zeitwerk"

# Logging (extracted from default gems in Ruby 4.0)
gem "logger"

# Tasks
gem "rake"

# Concurrency (extracted from default gems in Ruby 4.0)
gem "concurrent-ruby-ext", require: "concurrent"

# DNS resolution. Nothing here depends on it directly, but net/http requires it
# unconditionally, so ruby 4.0.6's default copy (0.7.0) is live code and
# CVE-2026-80212 hits it. Pinning the patched release makes bundler activate
# that ahead of the stdlib one; containers/Containerfile then deletes the copy
# it supersedes. Drop once the ruby toolchain ships a fixed default.
gem "resolv", ">= 0.7.2"

group :development do
  # listen for file changes
  gem "listen", require: false

  gem "rubocop", require: false
  gem "rubocop-performance", require: false
  gem "rubocop-rake", require: false
  gem "rubocop-rspec", require: false
  gem "rubocop-sequel", require: false
  # Vulnerability scanning
  gem "bundler-audit", require: false
end

group :development, :test do
  gem "irb", require: false # Required for YARD compatibility with Ruby 4.0
  gem "pry", require: false
end

group :test do
  gem "database_cleaner-sequel"
  gem "rack-test"
  gem "rspec"
end
