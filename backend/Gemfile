source "https://rubygems.org"

ruby "~> 4.0.0"

# Web framework
gem "falcon"
gem "rack-attack"
gem "roda", "~> 3.105"
gem "roda-websockets"

# Database
gem "pg"
gem "sequel"
gem "sequel_pg", require: "sequel"

# JSON
gem "json"
gem "jwt"

# Email
gem "mail", "~> 2.8"

# Web push notifications
gem "web-push", "~> 3.1"

# QR code generation
gem "chunky_png"
gem "rqrcode"

# Encryption (libsodium bindings)
gem "rbnacl"

# WebAuthn / Passkeys
gem "fido_metadata"
gem "webauthn"

# Session context — user-agent parsing and IP geolocation
gem "browser"
gem "mmdb"

# Monads
gem "dry-monads"

# Autoloading
gem "zeitwerk"

# Logging (extracted from default gems in Ruby 4.0)
gem "logger"

# Tasks
gem "rake"

# Concurrency (extracted from default gems in Ruby 4.0)
gem "concurrent-ruby-ext", require: "concurrent"

group :development do
  # listen for file changes
  gem "listen", require: false

  gem "rubocop", require: false
  gem "rubocop-performance", require: false
  gem "rubocop-rake", require: false
  gem "rubocop-rspec", require: false
  gem "rubocop-sequel", require: false
  # Vulnerability scanning
  gem "bundler-audit", require: false
end

group :development, :test do
  gem "irb", require: false # Required for YARD compatibility with Ruby 4.0
  gem "pry", require: false
end

group :test do
  gem "database_cleaner-sequel"
  gem "rack-test"
  gem "rspec"
end
