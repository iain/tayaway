# Non-secret production config — plain dotenv, tracked in git.
# Secrets (DATABASE_URL, APP_SECRET, VAPID_PRIVATE_KEY) live alongside
# in .env.production.yaml, sops-encrypted to operator + production
# recipients. mise loads both files when MISE_ENV=production.

# Public URL of the SPA — used in email links, WebAuthn config, and
# CSP origins. Stays on the apex; the new-stack edge container will
# serve both new.tayaway.nl and tayaway.nl once cutover flips DNS.
FRONTEND_URL=https://tayaway.nl

# Web push VAPID public key — emitted to the frontend, which uses it
# to subscribe to the push service. Public-by-design (it identifies
# this server to the browser's push provider). The private half lives
# in .env.production.yaml.
VAPID_PUBLIC_KEY="BDGR8hkLhjlzoc2vBx7CXKORJmJvXvXaEBxaRpta67Oo8Nsg8pOiHQQhT1kQ_fSZ_pDF935Hk7b2R0LODh_eViQ="

VAPID_SUBJECT=mailto:noreply@tayaway.nl

# Admin site (doc/admin.md). The allowlist is authorization, not a secret —
# an email here still needs that user's passkey AND the mTLS client cert.
# The extra WebAuthn origin lets passkeys registered on the apex
# authenticate on the admin vhost (same RP ID, registrable-suffix rule).
# ADMIN_DATABASE_URL (read-only role) lives in .env.production.yaml.
ADMIN_EMAILS=iain@iain.nl
WEBAUTHN_EXTRA_ORIGINS=https://admin.tayaway.nl
