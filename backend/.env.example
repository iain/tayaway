# Auto-generated from backend/config/schema.rb by `bundle exec rake config:example`.
# Re-run after editing the schema; don't edit this file by hand.
#
# Lines that start with `#` are optional overrides; uncomment to set.

# Postgres connection URL
DATABASE_URL=postgres://tayaway@localhost:5432/tayaway_development

# Session/cookie signing key (base64-encoded raw bytes)
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.base64(32)"
APP_SECRET=

# Public URL of the SPA — used in email links and WebAuthn config
FRONTEND_URL=http://localhost:5173

# Sequel max_connections per worker
# DATABASE_POOL_SIZE=16

# Falcon web worker count
# WEB_CONCURRENCY=1

# Falcon jobs worker count
# JOB_CONCURRENCY=1

# Falcon bind URL
# FALCON_URL=http://localhost:9292

# Override for the frontend dist directory
# STATIC_DIR=

# Soft-deleted item TTL (days)
# DELETED_ITEMS_RETENTION_DAYS=7

# Idempotency key TTL (hours)
# IDEMPOTENCY_KEY_TTL_HOURS=24

# Audit log retention (days)
# AUDIT_LOG_RETENTION_DAYS=365

# Extra WebAuthn origins (CSV)
# WEBAUTHN_EXTRA_ORIGINS=

# Build SHA — env, REVISION file, or git rev-parse
# GIT_SHA=

# ── Feature: Web push notifications ──
# Enabled when all of VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY are set.

# Web push public VAPID key
# VAPID_PUBLIC_KEY=

# Web push private VAPID key
# VAPID_PRIVATE_KEY=

# RFC 8292 subject — contact for push providers
# VAPID_SUBJECT=mailto:noreply@tayaway.nl

# ── Feature: Outbound email via SMTP ──
# Enabled when all of SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD are set.

# SMTP host
# SMTP_HOST=

# SMTP port
# SMTP_PORT=587

# SMTP username
# SMTP_USERNAME=

# SMTP password
# SMTP_PASSWORD=

# SMTP HELO domain
# SMTP_DOMAIN=tayaway.nl

# Default From address
# SMTP_FROM_EMAIL=noreply@tayaway.nl

# Default From display name
# SMTP_FROM_NAME=Tayaway

# Optional Reply-To address
# SMTP_REPLY_TO_EMAIL=

# Optional List-Unsubscribe address
# SMTP_UNSUBSCRIBE_EMAIL=
