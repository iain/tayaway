# Database
DATABASE_URL=postgres://tayaway:<password>@localhost:5432/tayaway_development

# Backend
PORT=9292
FRONTEND_URL=http://localhost:5173

# Secret used for HMAC, raw bytes, Base64 encoded
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.base64(32)"
APP_SECRET="<replace-me>"

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tayaway.nl
SMTP_FROM_NAME=Tayaway
SMTP_DOMAIN=tayaway.nl
# Optional. If set, added as the Reply-To header on outgoing mail.
# Should be a monitored mailbox.
SMTP_REPLY_TO_EMAIL=
# Optional. If set, opt-out-able mail (invitations, notifications) gets a
# `List-Unsubscribe: <mailto:...>` header pointing here. Must be a real,
# monitored mailbox — receivers may forward unsubscribe requests to it.
SMTP_UNSUBSCRIBE_EMAIL=
