#!/usr/bin/env bash
#MISE description="Create and migrate the development, test, and e2e databases"
#MISE depends=["//backend:setup:env"]

set -euo pipefail

# setup:env (a dependency) has generated the per-env dotenv files, so each
# env's DATABASE_URL is in place before we connect.
for env in development test e2e; do
  echo "Setting up $env database..."
  MISE_ENV="$env" mise exec -- bundle exec rake db:create db:migrate
done

echo "All databases ready"
