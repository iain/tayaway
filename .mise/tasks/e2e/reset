#!/usr/bin/env bash
#MISE description="Free the e2e ports (9293/5174/5175), killing only the e2e servers — never dev or other repos"

# Playwright runs with webServer.reuseExistingServer=false, so any server left
# on an e2e port by a crashed or interrupted run blocks the next `mise run e2e`
# (and `mise run ci`) for the full 120s webServer timeout. This frees them, and
# is wired in as an `e2e` dependency so the suite self-heals before Playwright
# tries to bind.
#
# Scoped strictly to e2e: it only touches the three e2e ports and the exact
# `mise run //…:e2e` wrappers Playwright spawns. Dev servers (9292/5173,
# pitchfork-managed) and unrelated processes are never touched. Killing by
# process GROUP takes a falcon-host supervisor, its forked workers, and their
# fsevent_watch children down together — so no broad `pkill fsevent_watch`
# (which would also kill dev's file watcher) is needed.

set -euo pipefail

self_pgid=$(ps -o pgid= -p "$$" 2>/dev/null | tr -d ' ' || true)
freed=0

for port in 9293 5174 5175; do
  for pid in $(lsof -ti :"$port" 2>/dev/null || true); do
    # `|| true`: a group-kill on one listener takes its siblings down too, so a
    # later pid in this list may already be gone — a failed lookup must not
    # abort the script (mise would fail e2e and SIGTERM the parallel db setup).
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    [ -z "$pgid" ] && continue
    [ "$pgid" = "$self_pgid" ] && continue # never kill our own run
    kill -KILL "-$pgid" 2>/dev/null || true
    freed=1
  done
done

# A `mise run //…:e2e` wrapper orphaned by an interrupted run can outlive a
# port-kill and respawn its server. Match only those exact invocations — never
# `mise run e2e` / `mise run ci`, which don't contain the `//…:e2e` task path.
for task in //backend:dev:e2e //frontend:dev:e2e //frontend:preview:e2e; do
  pkill -KILL -f "mise run $task" 2>/dev/null && freed=1 || true
done

if [ "$freed" -eq 1 ]; then
  echo "Freed e2e ports (9293/5174/5175)."
else
  echo "e2e ports already free."
fi
