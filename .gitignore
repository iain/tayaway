# Dependencies
node_modules/
.aube-store/

# Build outputs
dist/
build/

# Environment files
.env
.env.local
.env.*.local
backend/.env.development
backend/.env.test
backend/.env.e2e

# Per-developer mise overrides (tools, env, tasks). Never committed.
mise.local.toml
.mise.local.toml
backend/mise.local.toml
frontend/mise.local.toml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
aube-debug.log*

# Test outputs
coverage/
playwright-report/
test-results/

# Playwright visual-regression baselines are committed only for the CI
# environment (Linux). Local `--update-snapshots` runs on macOS/Windows
# generate platform-suffixed images that stay local — refresh the tracked
# baselines via `mise run e2e:snapshots:update` (Linux, in CI) instead.
e2e/tests/**/*-snapshots/*-darwin.png
e2e/tests/**/*-snapshots/*-win32.png

# Ruby
backend/.bundle/
backend/vendor/bundle/
*.gem

# Sorbet
# Note: gem RBIs (backend/sorbet/rbi/gems/) are committed.
# Shims (backend/sorbet/rbi/shims/) fill gaps where tapioca output is incomplete.
# Do NOT use `srb rbi todo` — add proper shims instead.

# Claude Code
.claude/worktrees/
.claude/settings.local.json
.worktrees/
doc/superpowers/
.superpowers/

# GeoIP database
backend/data/

# Misc
*.pid
*.seed
.cache/

tmp/

# Terraform / OpenTofu — provider binaries and crash logs are local; the
# lockfile (.terraform.lock.hcl) IS committed for reproducibility.
ops/**/.terraform/
ops/**/*.tfplan
ops/**/crash.log
ops/**/crash.*.log
# Local-only state for ops/bootstrap (see ops/bootstrap/.gitignore for why).
ops/bootstrap/terraform.tfstate
ops/bootstrap/terraform.tfstate.backup
