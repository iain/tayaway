# syntax=docker/dockerfile:1.7

# The toolchain image is built and pushed by CI from the three mise.toml files
# (`mise oci push ghcr.io/iain/tayaway-toolchain:<sha>`); each tool sits on its
# own layer so an aube bump does not invalidate the Ruby layer. The ARG is
# required — no default — so a forgotten `--build-arg` fails loudly instead
# of silently pulling a stale `:latest`. For local dev before CI's first
# push, run `mise oci push <registry>/tayaway-toolchain:dev` and pass
# `--build-arg TOOLCHAIN_IMAGE=<registry>/tayaway-toolchain:dev`.
ARG TOOLCHAIN_IMAGE

# ── frontend-build ──────────────────────────────────────────────────────────
# Emits frontend/dist. Consumed by the `edge` stage.
#
# mise oci push installs tools at /mise/installs/<tool>/<version>/bin without
# touching PATH. SHELL would route every RUN through `mise exec` but isn't
# honored by podman's default OCI image format — so each RUN that needs a
# mise-managed tool is prefixed explicitly. node's prebuilt binary depends
# on libatomic1, which the slim toolchain base does not include.
FROM ${TOOLCHAIN_IMAGE} AS frontend-build

RUN apt-get update && apt-get install -y --no-install-recommends \
      libatomic1 \
    && rm -rf /var/lib/apt/lists/*

# Trust mise.toml files copied in from the repo so `mise exec` doesn't
# prompt or refuse to load them mid-build.
ENV MISE_TRUSTED_CONFIG_PATHS=/build

WORKDIR /build

# aube-lock.yaml + aube-workspace.yaml live at the repo root (frontend and
# e2e are workspace members), so resolve from there and filter the install
# down to frontend's transitive deps.
COPY aube-lock.yaml aube-workspace.yaml package.json ./
COPY frontend/package.json ./frontend/
COPY e2e/package.json ./e2e/
RUN mise exec -- aube install --frozen-lockfile --filter @tayaway/frontend...

COPY frontend/ ./frontend/
RUN mise exec -- aube run --filter @tayaway/frontend build

# ── gem-build ───────────────────────────────────────────────────────────────
# Compiles native gem extensions. build-essential and the -dev headers live
# only here; the runtime `backend` stage below imports vendor/bundle and
# ships only the matching .so packages, saving ~300 MB off the final image.
FROM ${TOOLCHAIN_IMAGE} AS gem-build

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libmaxminddb-dev \
      libpq-dev \
      libsodium-dev \
      libyaml-dev \
    && rm -rf /var/lib/apt/lists/*

# BUNDLE_DEPLOYMENT is documented as "Equivalent to setting `frozen` to
# `true` and `path` to `vendor/bundle`" (Bundler 4 docs), so frozen and
# path don't need separate vars. Env vars are the single source of truth
# for bundler — no `.bundle/config` is written, so the runtime stage sees
# the same knobs without any state copied from the build.
ENV BUNDLE_DEPLOYMENT=true \
    BUNDLE_WITHOUT=development:test \
    MISE_TRUSTED_CONFIG_PATHS=/app

WORKDIR /app/backend

COPY backend/Gemfile backend/Gemfile.lock ./
RUN mise exec -- bundle install --jobs 4 --retry 3

# ── backend ─────────────────────────────────────────────────────────────────
# Runtime-only Falcon image. Production quadlet mounts this ReadOnly=true
# with a tmpfs on /tmp; nothing in this stage writes outside /tmp at runtime.
FROM ${TOOLCHAIN_IMAGE} AS backend

# ca-certificates is load-bearing, not cosmetic: the slim toolchain base ships
# no CA bundle, so Ruby's OpenSSL can't verify TLS peers — outbound SMTP
# submission (login-link emails, :465 implicit TLS) and Web Push to the push
# services both fail with "certificate verify failed". node bundles its own CA
# store so the frontend build doesn't need this, which is why it went unnoticed.
# `apt-get upgrade` pulls security fixes for the debian base packages the
# toolchain image inherits (e.g. libgnutls30, libcap2) — the image scan gates
# on those, so refresh them here rather than wait for a toolchain rebuild.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
      ca-certificates \
      libmaxminddb0 \
      libpq5 \
      libsodium23 \
      libyaml-0-2 \
    && rm -rf /var/lib/apt/lists/*

# The toolchain image bundles every mise tool — linters, formatters, node, the
# JS package manager — for CI and the build stages. This runtime only ever runs
# `mise exec -- bundle exec falcon-host`, so it needs ruby and nothing else.
# Drop the rest: the Go-built dev tools (actionlint, shfmt, …) carry their own
# vendored Go stdlib, which is what trips the gated Trivy scan on advisories we
# can't fix from here — and they have no business in a runtime image regardless.
# The tool config (auto-generated by `mise oci build`) must be trimmed to match,
# or `mise exec` tries to reinstall the pruned tools at startup — which on the
# read-only production rootfs fails outright.
RUN grep -E '^\[tools\]|^ruby ' /etc/mise/config.toml > /etc/mise/config.toml.trim \
    && mv /etc/mise/config.toml.trim /etc/mise/config.toml \
    && find /mise/installs -mindepth 1 -maxdepth 1 ! -name ruby -exec rm -rf {} +

WORKDIR /app/backend

COPY --from=gem-build /app/backend/vendor ./vendor
COPY backend/ ./

# Bundler 4 treats BUNDLE_DEPLOYMENT=true as equivalent to frozen + path
# vendor/bundle, so those don't need separate vars. Env vars (not
# .bundle/config) keep the runtime knobs explicit and independent of any
# state from the gem-build stage.
# LANG: bookworm-slim ships no default locale, leaving Ruby's default external
# encoding at US-ASCII — Rack::Builder.load_file then crashes on any non-ASCII
# byte in a rackup file (bit the admin site's config.ru).
ENV MISE_ENV=production \
    RACK_ENV=production \
    FALCON_URL=http://0.0.0.0:9292 \
    MISE_TRUSTED_CONFIG_PATHS=/app \
    BUNDLE_DEPLOYMENT=true \
    BUNDLE_WITHOUT=development:test \
    LANG=C.UTF-8

# The container has no .git and the podman deploy writes no REVISION file, so
# the git_sha fallback chain in config/environment.rb would resolve to empty.
# Bake the build's commit SHA in (passed by the App-images workflow);
# APP_CONFIG.git_sha then surfaces it on /health and the WS pong. Declared here,
# late in the stage, so a new SHA only busts this layer — not the apt/gem layers.
ARG GIT_SHA=""
ENV GIT_SHA=${GIT_SHA}

EXPOSE 9292

ENTRYPOINT ["mise", "exec", "--"]
CMD ["bundle", "exec", "falcon-host", "falcon.rb"]

# ── edge ────────────────────────────────────────────────────────────────────
# Caddy fronts the stack: serves the built SPA, reverse-proxies /api and /ws
# to the backend container, terminates TLS via ACME in production.
FROM caddy:2-alpine AS edge

# Pull alpine security fixes for the base packages the image scan gates on.
RUN apk upgrade --no-cache

COPY containers/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend-build /build/frontend/dist /srv/dist

EXPOSE 8080
EXPOSE 8443
