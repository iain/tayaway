# Caddy config for the edge container. SITE_ADDRESS pins the listener; in
# production it's the public hostname so Caddy provisions Let's Encrypt
# certs automatically. Locally it defaults to plain http on :8080.

# Bound shutdown drain. Without a grace_period Caddy waits forever for
# active connections ("shutting down with eternal grace period"), and live
# WebSocket subscriptions never drain on their own — so a deploy-time stop
# used to hang until podman's 10s SIGKILL, which systemd records as a unit
# failure and pages. 5s lets real requests finish, then force-closes the
# stragglers and exits cleanly, inside podman's 10s stop timeout.
{
	grace_period 5s
}

# Co-hosted side projects drop their own site blocks in /etc/caddy/sites/
# (mounted from the host — see ops/co-hosting.md). Each file is a full site
# block for its own domain and gets its own cert. The glob matches nothing in
# production until a tenant is added, which Caddy treats as a no-op. A broken
# snippet fails the whole config load, so tenant deploys must `caddy validate`
# before reloading.
import /etc/caddy/sites/*.caddy

# www → apex redirect. In production WWW_SITE_ADDRESS is https://www.tayaway.nl,
# so Caddy provisions an LE cert for www and 301s every request to the apex
# (canonical host). Unset locally / in e2e, it falls back to a localhost label
# that never triggers ACME and doesn't collide with the main :8080 block.
{$WWW_SITE_ADDRESS:http://localhost:8081} {
	redir https://tayaway.nl{uri} permanent
}

{$SITE_ADDRESS:http://:8080} {
	encode zstd gzip

	# Structured access log to stdout — quadlet routes it to journald, so
	# `journalctl -u tayaway-edge` shows per-request JSON without needing a
	# separate logfile. Filter noisy paths via `log_skip` later if needed.
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		# EXTRA_CONNECT_SRC lets staging / preview environments append their
		# own backend origin to connect-src (e.g. " wss://staging.tayaway.nl"
		# — note the leading space) without forking this config. Empty when
		# unset, so production's CSP matches the legacy nginx one.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://tayaway.nl https://photon.komoot.io{$EXTRA_CONNECT_SRC}; img-src 'self' data: blob: https://*.tile.openstreetmap.org; font-src 'self'; object-src 'none'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	}

	# WebSocket upgrade. reverse_proxy auto-detects the Upgrade header; we
	# just need to keep the stream open. `stream_timeout` is the documented
	# knob for long-lived WebSocket connections (replaces the nginx 86400s
	# read/write timeouts). `stream_close_delay` lets Caddy reloads finish
	# without killing live subscriptions mid-message.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy {$BACKEND_UPSTREAM:web:9292} {
			stream_timeout 24h
			stream_close_delay 5m
		}
	}

	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:web:9292}
	}

	# Backend health probe (does a real DB ping, 503 on failure). Proxied
	# explicitly because it lives at /health, not under /api — without this
	# it would fall through to the SPA and always look "200 OK" regardless
	# of backend state. The deploy smoke-test + uptime monitoring rely on it.
	handle /health {
		reverse_proxy {$BACKEND_UPSTREAM:web:9292}
	}

	# Everything else: the SPA. Wrapped in handle to keep it mutually
	# exclusive with the API/WS blocks above. `route` inside forces the
	# directives to run in declaration order so the asset Cache-Control
	# wins over the SPA-shell default (without route, Caddy sorts header
	# directives canonically and the unconditional default overwrites
	# the matched one).
	handle {
		root * /srv/dist
		route {
			# Vite emits content-hashed filenames under /assets — safe to
			# mark immutable. /assets/* always exists on disk, so try_files
			# never rewrites; this matcher fires reliably at request time.
			@assets path /assets/*
			header @assets Cache-Control "public, immutable, max-age=31536000"

			# Everything else gets no-cache. `?` means "set only if absent",
			# so the @assets directive above isn't overwritten. This also
			# applies to /index.html after try_files rewrites unknown
			# client-side routes (e.g. /events/<id>) — sidesteps Caddy's
			# request-phase matcher evaluation, which would see the
			# original URI, not /index.html.
			header ?Cache-Control "no-cache"

			# Real file → fall back to /index.html so client-side routes
			# still serve the Vue shell (frontend uses createWebHistory).
			# Canonical SPA pattern from the Caddy docs.
			try_files {path} /index.html

			# Serve the precompressed .br / .gz siblings emitted by
			# vite-plugin-compression2. Brotli first, gzip fallback. If a
			# sibling is missing, Caddy falls back to the original and the
			# `encode` directive at the top compresses on the fly.
			file_server {
				precompressed br gzip
			}
		}
	}
}
