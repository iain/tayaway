# Caddy config for the edge container. SITE_ADDRESS pins the listener; in
# production it's the public hostname so Caddy provisions Let's Encrypt
# certs automatically. Locally it defaults to plain http on :8080.
{$SITE_ADDRESS:http://:8080} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://tayaway.nl https://photon.komoot.io; img-src 'self' data: blob: https://*.tile.openstreetmap.org; font-src 'self'; object-src 'none'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	}

	# WebSocket upgrade. Long read/write timeouts match the 86400s the
	# legacy nginx config used so idle subscriptions don't get culled.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy {$BACKEND_UPSTREAM:web:9292} {
			transport http {
				read_timeout 86400s
				write_timeout 86400s
			}
		}
	}

	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:web:9292}
	}

	# Vite emits content-hashed filenames under /assets — safe to mark
	# immutable for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, immutable, max-age=31536000"

	# Static files first — including SPA index resolution for directory
	# paths. `try_files` rewrites `/` (and any path that hits a dir) to
	# `/index.html`, matching the implicit `index` behavior the legacy
	# nginx config relied on.
	root * /srv/dist
	try_files {path} {path}/index.html
	@spa_file file
	handle @spa_file {
		file_server
	}
	# Everything else falls through to the backend (server-rendered routes,
	# the 404 page). Caddy adds no-cache so the SPA shell isn't ever stale.
	handle {
		header Cache-Control "no-cache"
		reverse_proxy {$BACKEND_UPSTREAM:web:9292}
	}
}
