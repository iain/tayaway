# syntax=docker/dockerfile:1.7
#
# Postgres for the stack: stock postgres:18 plus a wal-g binary built from
# source WITH libsodium. The prebuilt wal-g release binaries omit libsodium
# (verified: no cgo link), and WALG_LIBSODIUM_KEY needs it for client-side
# backup encryption — so we compile it here. Postgres runs `wal-g wal-push`
# as its archive_command, and the backup / retention / restore-drill timers
# `podman exec` this same binary.
ARG WALG_VERSION=v3.0.8
# gosu publishes no semver tags, so the module proxy only offers pseudo-versions.
ARG GOSU_VERSION=v0.0.0-20260606051551-40506998e34a

# ── wal-g build ───────────────────────────────────────────────────────────────
# wal-g links libsodium and brotli via cgo, so the build needs their -dev
# headers + a C toolchain + cmake (brotli is built from a vendored checkout
# by `make deps`). USE_LIBSODIUM flips on the libsodium build tag + link.
FROM docker.io/library/golang:1.26-trixie AS walg-build
ARG WALG_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
      git make cmake gcc libc6-dev pkg-config libsodium-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${WALG_VERSION}" https://github.com/wal-g/wal-g /src
WORKDIR /src
ENV USE_LIBSODIUM=1
# wal-g v3.0.8 imports encoding/json/v2, which Go still gates behind this
# experiment. Split deps (slow C builds of brotli + libsodium) from the
# Go build so iterating on the build doesn't recompile them.
ENV GOEXPERIMENT=jsonv2
# The go.mod `toolchain` line is a floor, not a ceiling, so the default
# GOTOOLCHAIN=auto builds with the base image's Go. Bumping the base tag
# (Dependabot tracks it) is what picks up stdlib security fixes.
# v3.0.8 is the current wal-g release and its go.mod carries dependency
# versions with fixable CVEs, so there is no upstream bump to wait for — patch
# them here before the vendor step. The x/* three are a constraint chain
# (text pulls net, net pulls crypto); bump them together or MVS rejects the set.
RUN go get \
      github.com/jackc/pgx/v5@v5.9.0 \
      google.golang.org/grpc@v1.79.3 \
      go.mongodb.org/mongo-driver@v1.17.7 \
      golang.org/x/crypto@v0.53.0 \
      golang.org/x/net@v0.56.0 \
      golang.org/x/text@v0.39.0 \
    && go mod tidy
RUN make deps
RUN make pg_build
RUN echo "=== ldd ===" && ldd main/pg/wal-g || true; ./main/pg/wal-g --version
RUN install -D -m 0755 main/pg/wal-g /out/wal-g

# ── gosu build ────────────────────────────────────────────────────────────────
# postgres:18 ships a gosu compiled against an older Go, and its docker-entrypoint
# runs it on every start to drop from root to postgres. Rebuilding the same
# upstream source here puts it on the base image's toolchain, which is where
# stdlib security fixes arrive. CGO_ENABLED=0 keeps it static, matching the
# binary it replaces.
FROM docker.io/library/golang:1.26-trixie AS gosu-build
ARG GOSU_VERSION
RUN CGO_ENABLED=0 go install "github.com/tianon/gosu@${GOSU_VERSION}"

# ── runtime ───────────────────────────────────────────────────────────────────
# libsodium links statically into wal-g (ldd shows only libc), but wal-g still
# needs a CA bundle to verify TLS to OVH Object Storage — postgres:18 ships
# none, and without it wal-g's Go client silently retries the handshake
# forever. ca-certificates is the only runtime add.
#
# Named so images.yml can exclude this stage from the registry layer cache
# (no-cache-filters) — a cached layer would freeze the `apt-get upgrade` below
# at whenever the base digest last moved, silently skipping security fixes.
FROM docker.io/library/postgres:18 AS db
# apt-get upgrade pulls debian security fixes for the postgres base packages
# the image scan gates on; ca-certificates is wal-g's only functional add.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=walg-build /out/wal-g /usr/local/bin/wal-g
COPY --from=gosu-build /go/bin/gosu /usr/local/bin/gosu
# The entrypoint depends on gosu working as root and as a target user; fail the
# build here rather than at container start if the replacement misbehaves.
RUN gosu --version && gosu nobody true
