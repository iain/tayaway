# Oneshot loader for the DB-IP Lite city database. Writes to a named volume
# that the web container mounts read-only at /app/backend/data. Pairs with a
# monthly geoip.timer so refreshes are decoupled from app deploys; the web
# stat()s the file per-lookup and picks up new versions without restarting.
# Named so images.yml can exclude this stage from the registry layer cache
# (no-cache-filters) — a cached layer would freeze the `apk upgrade` below at
# whenever the base digest last moved, silently skipping security fixes.
FROM alpine:3.24 AS geoip

# apk upgrade pulls alpine security fixes for base packages the image scan
# gates on; then add the runtime deps the loader needs.
RUN apk upgrade --no-cache && apk add --no-cache bash curl

COPY containers/geoip-load.sh /usr/local/bin/geoip-load
RUN chmod +x /usr/local/bin/geoip-load

# Default target inside the volume the web container mounts. Override with
# DATA_DIR if the volume is mounted somewhere else.
ENV DATA_DIR=/data

ENTRYPOINT ["/usr/local/bin/geoip-load"]
