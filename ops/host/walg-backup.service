# Base/delta backup. Runs wal-g backup-push inside the db container, which
# reads $PGDATA off disk and connects back over the local socket for
# pg_backup_start/stop. WALG_DELTA_MAX_STEPS (set on db.container) makes this
# a delta off the latest full, rolling to a fresh full weekly. Triggered by
# walg-backup.timer.
[Unit]
Description=Tayaway WAL-G base/delta backup
Requires=db.service
After=db.service
ConditionPathExists=/run/tayaway/db.env

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec db sh -c 'wal-g backup-push "$PGDATA"'
