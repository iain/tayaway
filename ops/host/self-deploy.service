# Pull-based CD: poll GHCR's :main tag and deploy it if newer (see
# self-deploy.sh). Triggered by self-deploy.timer. Restarts migrate→web→edge
# itself, so it needs the stack present; gates on the web quadlet existing so
# it's a no-op on a half-provisioned box.
[Unit]
Description=Tayaway pull-based self-deploy
Requires=db.service
After=db.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/containers/systemd/web.container
# A failed deploy rolls back and records the bad SHA; page so a stuck deploy
# (bad image, GHCR auth lapsed) surfaces instead of silently not updating.
OnFailure=notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/self-deploy
# Pull + migrate + two Notify=true restarts + smoke-test can take a while.
TimeoutStartSec=600
