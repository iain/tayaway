# Host oneshot: decrypt POSTGRES_PASSWORD to /run/tayaway/db.env before
# the database starts. db.container declares Requires=/After= this unit.
# Conditions keep it from failing loudly on a half-provisioned box (no
# age key or env yaml yet) — it just stays inactive until both exist.
[Unit]
Description=Decrypt Tayaway DB password to tmpfs
ConditionPathExists=/etc/tayaway/age.key
ConditionPathExists=/etc/tayaway/env/.env.production.yaml
Before=db.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/tayaway-db-secret

[Install]
WantedBy=multi-user.target
