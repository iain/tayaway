# Daily WAL-G backup. Delta most days, full weekly (via WALG_DELTA_MAX_STEPS).
# Persistent catches a run missed while the box was down; the random delay
# avoids a thundering 02:30.
[Unit]
Description=Daily Tayaway WAL-G backup

[Timer]
OnCalendar=*-*-* 02:30:00
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
