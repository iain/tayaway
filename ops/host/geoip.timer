# Monthly GeoIP refresh. A plain systemd timer (NOT a Quadlet type, so it
# lives in /etc/systemd/system/, not /etc/containers/systemd/) that fires
# the Quadlet-generated geoip.service. DB-IP publishes on the 1st; we run
# on the 3rd so the new file is reliably up. Persistent=true catches a
# refresh missed while the box was down; the random delay avoids hitting
# DB-IP at a round hour. Unit= is explicit since the target is a
# generator-emitted unit, not a sibling file.
[Unit]
Description=Monthly Tayaway GeoIP refresh

[Timer]
Unit=geoip.service
OnCalendar=*-*-03 04:00:00
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
