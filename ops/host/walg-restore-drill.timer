# Monthly WAL-G restore drill (5th, 05:00). After the month's first daily
# backups have accumulated and clear of the geoip refresh (3rd) and the
# Monday retention prune. Persistent catches a miss while the box was down;
# the random delay avoids a round-hour spike against object storage.
[Unit]
Description=Monthly Tayaway WAL-G restore drill

[Timer]
OnCalendar=*-*-05 05:00:00
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
