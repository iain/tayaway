# Monthly restore drill — fetches the latest WAL-G backup into a throwaway
# container, replays WAL to consistency, runs a sanity query. Proves the
# backups are restorable; OnFailure pages via ntfy if they aren't. Triggered
# by walg-restore-drill.timer.
[Unit]
Description=Tayaway WAL-G restore drill
Requires=db.service
After=db.service
ConditionPathExists=/run/tayaway/db.env
OnFailure=notify@%n.service

[Service]
Type=oneshot
# Base fetch + WAL replay can take a few minutes on a cold object-store
# cache; give it generous headroom before systemd calls it failed.
TimeoutStartSec=900
ExecStart=/usr/local/bin/walg-restore-drill
