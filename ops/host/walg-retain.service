# Retention prune. Keeps the last 4 full backups (~1 month of daily deltas)
# plus the WAL needed to recover from the oldest of them, and drops the rest.
# Triggered by walg-retain.timer.
[Unit]
Description=Tayaway WAL-G retention prune
Requires=db.service
After=db.service
ConditionPathExists=/run/tayaway/db.env
OnFailure=notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec db wal-g delete retain FULL 4 --confirm
