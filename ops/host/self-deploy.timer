# Poll for a new main image every ~3 minutes. That's the deploy latency
# (pull-based trades instant-push for no inbound access). OnBootSec gives the
# stack a moment to settle after a reboot before the first check; the small
# random delay avoids hammering GHCR on a round tick.
[Unit]
Description=Poll for a new Tayaway main image and self-deploy

[Timer]
OnBootSec=3min
OnUnitActiveSec=3min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
