# Falcon backend. Decrypts .env.production.yaml in-process at start via
# the mounted age key + mise. Notify=true so podman waits for falcon's
# sd_notify READY=1 — a restart doesn't complete until workers accept
# connections, preserving today's ordering guarantee.
#
# Hardening carried over from the legacy systemd unit: read-only rootfs
# with /tmp on tmpfs (Falcon + ERB need a writable temp dir), all
# capabilities dropped (Falcon binds the unprivileged 9292), NOFILE
# raised for the WebSocket fd + Sequel pool load, and StartLimit so a
# crash loop gives up instead of spinning. MISE_CACHE_DIR points at the
# tmpfs so mise has somewhere writable under the read-only rootfs.
[Unit]
Description=Tayaway Falcon backend
Requires=db.service migrate.service
After=db.service migrate.service
# StartLimit* are [Unit] keys — systemd ignores them in [Service].
StartLimitBurst=3
StartLimitIntervalSec=60

[Container]
ContainerName=web
Image=ghcr.io/iain/tayaway-backend:943a6579d0b03b6d24dc8686fd3a88ff0884517d
Network=tayaway.network
Volume=/etc/tayaway/env/.env.production:/app/backend/.env.production:ro
Volume=/etc/tayaway/env/.env.production.yaml:/app/backend/.env.production.yaml:ro
Volume=/etc/tayaway/age.key:/etc/tayaway/age.key:ro
Volume=tayaway-geoip.volume:/app/backend/data:ro
Environment=MISE_SOPS_AGE_KEY_FILE=/etc/tayaway/age.key
Environment=MISE_CACHE_DIR=/tmp/mise-cache
Notify=true
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=all
Pull=missing

[Service]
LimitNOFILE=65536
Restart=on-failure

[Install]
WantedBy=multi-user.target
