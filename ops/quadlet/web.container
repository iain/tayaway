# Falcon backend. Decrypts .env.production.yaml in-process at start via
# the mounted age key + mise. Notify=true so podman waits for falcon's
# sd_notify READY=1 — a restart doesn't complete until workers accept
# connections, preserving today's ordering guarantee.
#
# Hardening carried over from the legacy systemd unit: read-only rootfs
# with /tmp on tmpfs (Falcon + ERB need a writable temp dir), all
# capabilities dropped (Falcon binds the unprivileged 9292), NOFILE
# raised for the WebSocket fd + Sequel pool load, and StartLimit so a
# crash loop gives up instead of spinning. HOME and MISE_CACHE_DIR point at
# the tmpfs so bundler and mise have somewhere writable under the read-only
# rootfs.
[Unit]
Description=Tayaway Falcon backend
Requires=db.service migrate.service
After=db.service migrate.service
# StartLimit* are [Unit] keys — systemd ignores them in [Service].
StartLimitBurst=3
StartLimitIntervalSec=60
# Page on failure once the crash loop gives up (pairs with StartLimitBurst).
OnFailure=notify@%n.service

[Container]
ContainerName=web
Image=ghcr.io/iain/tayaway-backend:4c29c7d738859ba9bf65c27af0ae5a36d39ce64b
Network=tayaway.network
Volume=/etc/tayaway/env/.env.production:/app/backend/.env.production:ro
Volume=/etc/tayaway/env/.env.production.yaml:/app/backend/.env.production.yaml:ro
Volume=/etc/tayaway/age.key:/etc/tayaway/age.key:ro
Volume=tayaway-geoip.volume:/app/backend/data:ro
Environment=MISE_SOPS_AGE_KEY_FILE=/etc/tayaway/age.key
Environment=MISE_CACHE_DIR=/tmp/mise-cache
# HOME defaults to /root, which isn't writable under ReadOnly=true — bundler
# logs "/root is not writable" and falls back to a temp dir, and mise warns it
# can't write ~/.local/state. Point HOME at the tmpfs so both get a writable
# home and start cleanly.
Environment=HOME=/tmp
Notify=true
ReadOnly=true
Tmpfs=/tmp
# Deliberately NOT NoNewPrivileges=true. With podman's containers-default
# AppArmor profile, no_new_privs makes AppArmor deny falcon-host (pid 1)
# signalling its own forked web/jobs workers on shutdown — Process.kill
# returns EACCES (verified on the box: cap-drop=all alone is fine, adding
# no-new-privileges reproduces it, and CAP_KILL does not rescue it). The
# result is podman SIGKILLing workers instead of a graceful stop. Dropping
# no_new_privs is low-risk here: DropCapability=all leaves an empty bounding
# set, so the setuid-based privilege escalation no_new_privs guards against
# is already neutered.
DropCapability=all
# falcon-host's own graceful-stop timeout is 10s — the same as podman's
# default stop timeout — so a worker that failed to drain raced podman's
# SIGKILL and recorded exit 137 (a paged unit failure). 15s lets
# falcon-host's internal escalation (kill the stuck worker, exit cleanly)
# win that race. Normal stops drain in <1s via Websocket::Shutdown; this
# is only the backstop. (Quadlet's StopTimeout= needs podman 5; host runs 4.9.)
PodmanArgs=--stop-timeout=15
Pull=missing

[Service]
LimitNOFILE=65536
Restart=on-failure

[Install]
WantedBy=multi-user.target
