# Caddy edge: serves the built SPA, reverse-proxies /api and /ws to web,
# terminates TLS via Let's Encrypt. Replaces nginx + certbot.
#
# SITE_ADDRESS is the public hostname, which makes Caddy bind :80 + :443
# and provision a real LE cert automatically — so we publish the standard
# host ports straight through (not the 8080/8443 the Containerfile EXPOSEs
# for the local http default). During commissioning the frontend talks to
# wss://new.tayaway.nl, which isn't in the Caddyfile's baked connect-src
# (that has wss://tayaway.nl for post-cutover), so EXTRA_CONNECT_SRC
# appends it — note the leading space. Drop EXTRA_CONNECT_SRC at cutover.
#
# The caddy volume persists the ACME account + issued certs so a restart
# doesn't re-request from LE and trip rate limits.
[Unit]
Description=Tayaway Caddy edge
Wants=web.service
After=web.service
# StartLimit* are [Unit] keys — systemd ignores them in [Service].
StartLimitBurst=3
StartLimitIntervalSec=60

[Container]
ContainerName=edge
Image=ghcr.io/iain/tayaway-edge:3ce61b0fb4a209ad386f7cb1925e6f3e6dce9b03
Network=tayaway.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Volume=tayaway-caddy.volume:/data
Environment=SITE_ADDRESS=https://new.tayaway.nl
Environment=BACKEND_UPSTREAM=web:9292
Environment="EXTRA_CONNECT_SRC= wss://new.tayaway.nl"
NoNewPrivileges=true
Pull=missing

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
