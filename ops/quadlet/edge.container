# Caddy edge: serves the built SPA, reverse-proxies /api and /ws to web,
# terminates TLS via Let's Encrypt. Replaces nginx + certbot.
#
# SITE_ADDRESS is the public hostname, which makes Caddy bind :80 + :443
# and provision a real LE cert automatically — so we publish the standard
# host ports straight through (not the 8080/8443 the Containerfile EXPOSEs
# for the local http default).
#
# The caddy volume persists the ACME account + issued certs so a restart
# doesn't re-request from LE and trip rate limits.
[Unit]
Description=Tayaway Caddy edge
Wants=web.service
After=web.service
# StartLimit* are [Unit] keys — systemd ignores them in [Service].
StartLimitBurst=3
StartLimitIntervalSec=60
# Page on failure once the crash loop gives up (pairs with StartLimitBurst).
OnFailure=notify@%n.service

[Container]
ContainerName=edge
Image=ghcr.io/iain/tayaway-edge:e70495c3637da5b0a33a88e6079e03e30ad23bea
Network=tayaway.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Volume=tayaway-caddy.volume:/data
# Site config for co-hosted side projects, dropped on the host (see
# ops/co-hosting.md). The baked Caddyfile imports /etc/caddy/sites/*.caddy;
# read-only so a tenant can't rewrite the edge's own config.
Volume=/etc/caddy/sites:/etc/caddy/sites:ro
Environment=SITE_ADDRESS=https://tayaway.nl
# Serve www.tayaway.nl too (LE cert + 301 to the apex). Needs the www DNS
# records pointing here first, which ops/dns.tf manages.
Environment=WWW_SITE_ADDRESS=https://www.tayaway.nl
Environment=BACKEND_UPSTREAM=web:9292
NoNewPrivileges=true
Pull=missing

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
