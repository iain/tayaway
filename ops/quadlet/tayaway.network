# Internal bridge network for the stack. podman runs a DNS resolver on
# it, so containers reach each other by ContainerName — db:5432 (from
# DATABASE_URL) and web:9292 (from the Caddyfile's BACKEND_UPSTREAM).
# Nothing is published here; only edge.container maps host 80/443.
#
# IPv6=true makes the bridge dual-stack: netavark assigns a ULA v6 subnet
# and the containers get a v6 address, so edge's published 80/443 can be
# DNAT'd from the host's v6 as well as its v4. Without this the bridge is
# v4-only and the box silently refuses v6 on 443 (containers have no v6
# address to forward to) — which breaks every IPv6 client the moment the
# apex AAAA flips to this box. The host's single OVH /128 suffices: inbound
# v6 hits it and netavark forwards to the container's ULA address.
[Unit]
Description=Tayaway internal container network

[Network]
Label=app=tayaway
IPv6=true
