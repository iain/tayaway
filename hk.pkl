// hk — git hook manager (https://hk.jdx.dev). Owns the pre-commit pipeline.
// Installed once per machine with `hk install --global`; `mise run setup:hooks`
// is a per-repo fallback. Requires the pkl CLI (see root mise.toml [tools]).
//
// The amends URL hard-codes the hk version, which is why `hk` is pinned (not
// "latest") in mise.toml — the binary and this schema must move together. To
// upgrade, bump both in one commit (re-run `hk init` in a scratch dir to see
// the current URL); a binary reading a stale Config.pkl can fail to parse.
amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"

// Skip vendored, generated, and binary-baseline paths across every step —
// unions with per-step excludes. Mainly keeps the repo-wide `hk util` guards
// below off lockfiles' neighbours and committed Playwright snapshot images.
exclude = List(
  "node_modules/**",
  "backend/vendor/**",
  "frontend/dist/**",
  "playwright-report/**",
  "test-results/**",
  "**/*-snapshots/**",
)

// Git hooks run in a bare environment with no mise shell activation, so each
// project linter is wrapped in `mise exec --` to provision its toolchain
// (ruby+bundler for rubocop, node+aube for eslint). hk runs steps from the
// repo root and does not honour `dir` for workspace templating, so each
// command `cd`s into its {{workspace}} (the dir of the matched indicator)
// where {{workspace_files}} are relative and the tool finds its config + deps.
local linters = new Mapping<String, Step> {
  // RuboCop — backend Ruby. `workspace_indicator = "Gemfile"` anchors at
  // backend/ (the only Gemfile). --no-server matches the old mise task (the
  // daemon could wedge onto a stale cwd and pass files CI then rejected).
  ["rubocop"] {
    glob = List("backend/**/*.rb", "backend/**/*.rake", "backend/Rakefile", "backend/config.ru")
    exclude = "backend/vendor/**"
    workspace_indicator = "Gemfile"
    // Run the read-only check first; only shell the slow `-A` autofix when a
    // file is actually dirty (the common clean commit skips it and the write-lock).
    check_first = true
    check = "cd {{workspace}} && mise exec -- bundle exec rubocop --no-server -f q {{workspace_files}}"
    fix = "cd {{workspace}} && mise exec -- bundle exec rubocop --no-server -f q -A {{workspace_files}}"
  }
  // ESLint — frontend. package.json anchors at frontend/.
  ["eslint"] {
    glob = List("frontend/src/**/*.ts", "frontend/src/**/*.vue", "frontend/src/**/*.js", "frontend/src/**/*.mts")
    workspace_indicator = "package.json"
    check_first = true
    check = "cd {{workspace}} && mise exec -- aube exec eslint {{workspace_files}}"
    fix = "cd {{workspace}} && mise exec -- aube exec eslint --fix {{workspace_files}}"
  }
  // Prettier — frontend formatting. ESLint owns code correctness and (via
  // eslint-config-prettier) defers all stylistic rules to Prettier, but nothing
  // actually ran Prettier before this step, so formatting went unenforced. Same
  // file set as ESLint. `depends` serialises it after ESLint so the two never
  // race on the same file (ESLint --fix first, then Prettier formats the result).
  // Run from the repo root: prettier + prettier.config.js live in the root
  // package, not frontend/, so `aube exec` resolves them there.
  ["prettier"] {
    glob = List("frontend/src/**/*.ts", "frontend/src/**/*.vue", "frontend/src/**/*.js", "frontend/src/**/*.mts")
    depends = List("eslint")
    check_first = true
    check = "mise exec -- aube exec -- prettier --check {{files}}"
    fix = "mise exec -- aube exec -- prettier --write {{files}}"
  }
  // TOML formatting with taplo (the standard TOML formatter), modelled on hk's
  // `taplo-format` builtin. Replaces the old `mise fmt` step, which was a
  // whole-repo, exclusive formatter that ignored the staged {{files}} and
  // reformatted the tree on every commit — against pre-commit's "act only on
  // what's staged" grain. taplo formats each staged .toml in place. Like the
  // other linters it's wrapped in `mise exec` (taplo is a mise tool, absent
  // from the bare hook PATH); RUST_LOG=warn mutes taplo's per-run INFO line so
  // clean commits stay silent.
  ["taplo"] {
    glob = "**/*.toml"
    check_first = true
    check = "RUST_LOG=warn mise exec -- taplo format --check --diff {{files}}"
    fix = "RUST_LOG=warn mise exec -- taplo format {{files}}"
  }
  // ShellCheck — shell scripts (incl. the extension-less mise task scripts,
  // which carry bash shebangs ShellCheck detects). Check-only; findings need a
  // human, so a clean autofix isn't on offer.
  ["shellcheck"] {
    glob = List("**/*.sh", "**/*.bash", ".mise/tasks/**/*", "backend/.mise/tasks/**/*")
    check = "mise exec -- shellcheck {{files}}"
  }
  // shfmt — shell formatting for the same file set. `-i 2` matches the repo's
  // existing two-space indentation (shfmt defaults to tabs, which would churn
  // every script).
  ["shfmt"] {
    glob = List("**/*.sh", "**/*.bash", ".mise/tasks/**/*", "backend/.mise/tasks/**/*")
    check_first = true
    check = "mise exec -- shfmt -i 2 --diff {{files}}"
    fix = "mise exec -- shfmt -i 2 -w {{files}}"
  }
  // actionlint — GitHub Actions workflow validation. Shells out to ShellCheck
  // (also a mise tool, on the same mise-provided PATH) to lint `run:` blocks.
  // Check-only. The glob mirrors actionlint's own scope so it never fires on
  // unrelated YAML (e.g. the sops-encrypted secrets files).
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "mise exec -- actionlint {{files}}"
  }
  // CACHE_VERSION guard. Self-contained: diffs poolDb.ts/pool.ts against the
  // base branch and self-skips when neither changed. Check-only, no fix.
  ["cache-version"] {
    glob = List("frontend/src/api/poolDb.ts", "frontend/src/types/pool.ts", "scripts/check-cache-version.sh")
    check = "./scripts/check-cache-version.sh"
  }
  // Rust-native guards shipped in the hk binary — no toolchain, so they're
  // invoked via `mise exec -- hk` (hk is itself a mise tool, not on PATH in a
  // bare hook). Run repo-wide, scoped by the top-level `exclude`; all of them
  // detect and skip binary files by content, so the `**/*` glob is safe.
  ["merge-conflict"] {
    glob = "**/*"
    check = "mise exec -- hk util check-merge-conflict {{files}}"
  }
  ["private-key"] {
    glob = "**/*"
    check = "mise exec -- hk util detect-private-key {{files}}"
  }
  ["large-files"] {
    glob = "**/*"
    check = "mise exec -- hk util check-added-large-files --maxkb 500 {{files}}"
  }
  // Whitespace hygiene fixers. check-first so a clean commit skips the write;
  // --diff reports, --fix rewrites (trailing whitespace removed, mixed CRLF/CR
  // normalised to LF, exactly one trailing newline).
  ["trailing-whitespace"] {
    glob = "**/*"
    check_first = true
    check = "mise exec -- hk util trailing-whitespace --diff {{files}}"
    fix = "mise exec -- hk util trailing-whitespace --fix {{files}}"
  }
  ["mixed-line-ending"] {
    glob = "**/*"
    check_first = true
    check = "mise exec -- hk util mixed-line-ending --diff {{files}}"
    fix = "mise exec -- hk util mixed-line-ending --fix {{files}}"
  }
  ["end-of-file-fixer"] {
    glob = "**/*"
    check_first = true
    check = "mise exec -- hk util end-of-file-fixer --diff {{files}}"
    fix = "mise exec -- hk util end-of-file-fixer --fix {{files}}"
  }
}

hooks {
  // Runs on commit against staged files: stash unstaged changes, autofix,
  // restage what was fixed.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  // `hk check` / `mise run lint` under CI — report-only, no writes.
  ["check"] {
    steps = linters
  }
  // `hk fix` / `mise run lint` locally — autofix the whole tree. Unlike the
  // pre-commit hook, this leaves fixes unstaged (stage = false) so running the
  // linter doesn't silently stage files, matching the old `rubocop -A` task.
  ["fix"] {
    fix = true
    stage = false
    steps = linters
  }
}
