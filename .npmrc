; aube install hardening (supply-chain security). The rest of the aube config
; lives in aube-workspace.yaml; these three sit here because strict-dep-builds
; has no aube-workspace.yaml key (only .npmrc / env), so grouping all three
; keeps the install-security policy in one documented place.

; Fail the install if a dependency introduces a build/lifecycle script not
; already reviewed in aube-workspace.yaml's allowBuilds (today: esbuild,
; puppeteer) — surfaces a new postinstall at review time instead of silently
; skipping it.
strict-dep-builds=true

; Reject packages whose registry metadata carries no dist.integrity (SRI) hash.
strict-store-integrity=true

; Require the OSV malicious-package advisory check to run (fail closed) on fresh
; resolutions, rather than the default best-effort "on".
advisory-check=required
