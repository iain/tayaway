[Unit]
Description=Tayaway Falcon Application Server
After=network.target postgresql.service
Requires=postgresql.service
# Stop trying to recover after three failures in a minute. Without this,
# a deploy that ships a process that crashes immediately on boot will
# loop quietly under Restart=on-failure forever; with it, systemd marks
# the unit failed and stops restarting, which is what should page someone.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# `notify` (rather than `simple`) gates "active" on falcon-host telling
# systemd it is ready to serve, instead of on fork() returning. Required
# for systemctl restart to wait for the new process to actually be
# accepting connections — without it, deploy completion races ahead of
# the new workers being ready. async-container speaks the sd_notify
# protocol via NOTIFY_SOCKET (Notify::Socket) when systemd sets it.
Type=notify
# ExecStart goes through `mise run`, which leaves mise as an
# intermediate parent above falcon-host. Without this, systemd would
# only accept sd_notify from MainPID (mise) and drop falcon-host's
# READY=1, leaving the unit stuck in "activating" until timeout.
NotifyAccess=all
User=tayaway
Group=tayaway
WorkingDirectory=/var/www/tayaway/current/backend
# mise loads .env.production via backend/mise.toml's `_.file` directive,
# keyed off MISE_ENV. systemd no longer reads the env file directly —
# one parser, one source of truth across dev, test, e2e, and prod.
Environment=MISE_ENV=production
Environment=MISE_TRUSTED_CONFIG_PATHS=/var/www/tayaway
Environment=MISE_EXPERIMENTAL=1
Environment=PATH=/home/tayaway/.local/share/mise/installs/ruby/<%= ruby_version %>/bin:/home/tayaway/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GEM_HOME=/var/www/tayaway/shared/backend/vendor/bundle/ruby/<%= ruby_gem_version %>
Environment=GEM_PATH=/var/www/tayaway/shared/backend/vendor/bundle/ruby/<%= ruby_gem_version %>
Environment=FALCON_URL=http://127.0.0.1:9292
# mise resolves the env (loads .env.production via _.file) and then
# runs the `serve` task in backend/mise.toml, which exec's into the
# Bundler binstub for falcon-host. Bundler is what loads falcon — going
# via the binstub gets `require "bundler/setup"` ahead of the gem
# activation that config.ru triggers, which otherwise races a second
# default-config falcon serve onto port 9292 and crashes the unit.
ExecStart=/home/tayaway/.local/bin/mise run serve
# MainPID is mise (the launcher), not falcon-host. The serve task uses
# `exec` so mise's one child IS falcon-host — pgrep -P finds it and
# forwards SIGHUP, which Async::Container::Controller treats as a
# graceful worker restart.
ExecReload=/bin/sh -c 'pgrep -P $MAINPID | xargs -r kill -HUP'
# Cap the graceful-stop window. async-container's container.stop sends
# SIGINT and waits up to its 10 s graceful timeout before SIGKILL, so
# 15 s leaves a small buffer for the host process itself to finish
# tearing down — shorter than systemd's 90 s default, so a stuck
# shutdown shows up promptly instead of holding up a deploy.
TimeoutStopSec=15
# WebSocket connections plus the Sequel pool plus per-fiber sockets add
# up well past the 1024-fd soft default on most distros. 65536 leaves
# headroom that we will not realistically grow into.
LimitNOFILE=65536
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tayaway-falcon

# Falcon never needs root, never needs to escalate, and never writes
# outside the deploy tree. These four directives cover the realistic
# threats a process compromise would otherwise reach for.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
