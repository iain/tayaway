[Unit]
Description=Tayaway Falcon Application Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=tayaway
Group=tayaway
WorkingDirectory=/var/www/tayaway/current/backend
EnvironmentFile=/var/www/tayaway/shared/backend/.env.production
Environment=RACK_ENV=production
Environment=MISE_TRUSTED_CONFIG_PATHS=/var/www/tayaway
Environment=PATH=/home/tayaway/.local/share/mise/installs/ruby/<%= ruby_version %>/bin:/usr/local/bin:/usr/bin:/bin
Environment=GEM_HOME=/var/www/tayaway/shared/backend/vendor/bundle/ruby/<%= ruby_gem_version %>
Environment=GEM_PATH=/var/www/tayaway/shared/backend/vendor/bundle/ruby/<%= ruby_gem_version %>
# Two non-obvious flags here:
#  * `bundle exec`: invoking the bare `bin/falcon` shim activates the
#    falcon gem manually via `Gem.activate_and_load_bin_path` without
#    running `Bundler.setup`. With our config.ru's `Bundler.require` then
#    re-entering Bundler later, that bootstraps a *second* default-config
#    `Falcon::Command::Serve` inside the same process, which races the
#    first for port 9292 and crashes the unit. Going through `bundle exec`
#    sets Bundler up cleanly up front and the second invocation
#    disappears.
#  * `--threaded`: the default forked-container model also fails worker
#    readiness handshakes on this kernel/glibc combination under the
#    tayaway user. Threaded mode runs in one process and works reliably.
ExecStart=/home/tayaway/.local/bin/mise exec -- bundle exec falcon serve --threaded --bind http://127.0.0.1:9292
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tayaway-falcon

# Falcon never needs root, never needs to escalate, and never writes
# outside the deploy tree. These four directives cover the realistic
# threats a process compromise would otherwise reach for.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
